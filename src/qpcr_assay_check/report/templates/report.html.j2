  {% set win = fy | selectattr('year', 'ge', first_window) | list %}
  <tr class="group"><th scope="row">Summary window {{ first_window }}&ndash;{{ last_year }}</th><td></td><td class="num">{{ win | sum(attribute='with_region') }}</td>{{ frag_cells(win | sum(attribute='detectable'), win | sum(attribute='at_risk'), win | sum(attribute='likely_failure'), win | sum(attribute='undetermined'), win | sum(attribute='with_region'), 0, win | sum(attribute='unassembled'), win | sum(attribute='from_parts')) }}</tr>
  <tr class="group"><th scope="row">All years shown</th><td></td><td class="num">{{ fy | sum(attribute='with_region') }}</td>{{ frag_cells(fy | sum(attribute='detectable'), fy | sum(attribute='at_risk'), fy | sum(attribute='likely_failure'), fy | sum(attribute='undetermined'), fy | sum(attribute='with_region'), 0, fy | sum(attribute='unassembled'), fy | sum(attribute='from_parts')) }}</tr>
  </tbody>
</table></div>
{% endif %}
{% for o in r.inclusivity.oligos %}
