# Copy to .env (never commit .env) or export these variables in your shell.
# Not used until v0.2.0, which introduces the NCBI client.
#
# NCBI asks every API user to identify themselves. Use a real address that
# reaches you or your lab, so NCBI can contact you if your usage causes problems.
NCBI_EMAIL=your.name@example.org

# Optional but recommended: raises the E-utilities limit from 3 to 10 requests/second.
# Create one in your NCBI account settings (API Key Management).
NCBI_API_KEY=
